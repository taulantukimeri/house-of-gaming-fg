generator client {
  provider      = "prisma-client-js"
  // "native"              = your local Windows dev machine
  // "debian-openssl-1.1.x" = Hostinger Ubuntu 20.04
  // "debian-openssl-3.0.x" = Hostinger Ubuntu 22.04+
  // Removed: linux-musl (Alpine/Docker), rhel (Red Hat) — not used on Hostinger
  // Saves ~140 MB of disk space (4 × ~35 MB engine binaries removed)
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Generic key-value settings store
model Setting {
  key   String @id
  value String @default("")
}

// Fully editable homepage banner slides
model BannerSlide {
  id       Int     @id @default(autoincrement())
  position Int     @default(0)
  active   Boolean @default(true)
  tag      String  @default("")
  title    String  @default("")
  sub      String  @default("")
  cta      String  @default("Shop Now")
  href     String  @default("/catalog")
  imageUrl String?
  bg       String  @default("linear-gradient(135deg, #1A1A2E 0%, #16213E 100%)")
  accent   String  @default("#F26522")
}

model Category {
  id          String    @id
  name        String
  count       Int       @default(0)
  art         String
  description String?
  products    Product[]
}

model Product {
  id          String   @id
  sku         String   @unique
  catId       String
  category    Category @relation(fields: [catId], references: [id])
  catLabel    String
  brand       String
  name        String
  fullName    String
  blurb       String
  description String
  price       Int
  msrp        Int?
  stock       String
  stockLabel  String
  quantity    Int      @default(0)
  imageUrl    String?
  verified    Boolean  @default(false)
  badge       String?
  art         String
  specs       String
  swatches    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
